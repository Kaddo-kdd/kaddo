---
import BlogLayout from '../../../../layouts/BlogLayout.astro'
import { getPosts, getTags, postPath, formatDate } from '../../../../lib/blog'

export async function getStaticPaths() {
  const tags = await getTags('es')
  return tags.map(({ tag }) => ({ params: { tag }, props: { tag } }))
}

const { tag } = Astro.props
const posts = (await getPosts('es')).filter((p) => p.data.tags.includes(tag))
const description = `Artículos del blog de Kaddo con la etiqueta "${tag}".`
---
<BlogLayout title={`#${tag} · Blog`} description={description} path={`/es/blog/tags/${tag}/`} locale="es">
  <p style="margin:0 0 6px"><a href="/es/blog/">← Blog</a></p>
  <h1 style="font-size:2rem;margin:0 0 20px">#{tag}</h1>
  <div style="display:flex;flex-direction:column;gap:16px">
    {posts.map((p) => (
      <article style="border:1px solid var(--kaddo-border);border-radius:16px;background:var(--kaddo-surface);padding:18px 20px;box-shadow:var(--kaddo-shadow-sm)">
        <a href={postPath(p)} style="color:inherit;text-decoration:none">
          <h3 style="margin:0 0 6px;font-size:1.15rem;color:var(--sl-color-white)">{p.data.title}</h3>
          <p style="margin:0 0 8px;color:var(--kaddo-tech-gray);font-size:0.95rem">{p.data.description}</p>
          <div style="font-size:0.82rem;color:var(--kaddo-tech-gray)"><time datetime={p.data.publishedAt.toISOString()}>{formatDate(p.data.publishedAt, 'es')}</time></div>
        </a>
      </article>
    ))}
  </div>
</BlogLayout>
