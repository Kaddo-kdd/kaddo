---
import '../styles/brand.css'
import Analytics from '../components/Analytics.astro'

export interface Props {
  title: string
  description: string
  /** Path of this page, e.g. /blog/foo/ — used for canonical + og:url. */
  path: string
  locale: 'en' | 'es'
  /** OG/Twitter image: a site-relative path or absolute URL. Defaults to the Kaddo banner. */
  image?: string
  /** 'article' renders BlogPosting JSON-LD + article meta; 'website' is the index/tag pages. */
  type?: 'website' | 'article'
  publishedAt?: Date
  updatedAt?: Date
  author?: string
  tags?: string[]
  /** hreflang alternate: the equivalent page in the other locale, when it exists. */
  alternate?: { locale: 'en' | 'es'; path: string } | null
  /** Where the header language switcher sends the reader for the OTHER locale. Defaults to the
   *  other locale's blog index when not provided (e.g. index/tag pages). */
  altLangPath?: string
  /** Override the canonical URL (e.g. a cross-post's original source). Defaults to this page. */
  canonicalUrl?: string
}

const site = Astro.site ?? new URL('https://kaddo.org')
const {
  title, description, path, locale, image = '/banner.png', type = 'website',
  publishedAt, updatedAt, author = 'Julian Dario Luna Patiño', tags = [], alternate = null,
  altLangPath, canonicalUrl,
} = Astro.props

// Language switcher target for the OTHER locale: the explicit alternate (equivalent article),
// else the other locale's blog index.
const otherIndex = locale === 'es' ? '/blog/' : '/es/blog/'
const switchHref = altLangPath ?? alternate?.path ?? otherIndex

const pageUrl = new URL(path, site).href
const canonical = canonicalUrl ?? pageUrl
const ogImage = new URL(image, site).href
const siteName = 'Kaddo'
const fullTitle = `${title} · Kaddo`
const docsLabel = locale === 'es' ? 'Documentación' : 'Docs'
const homeHref = locale === 'es' ? '/es/' : '/'

const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      author: { '@type': 'Person', name: author, url: 'https://kaddo.org/about/' },
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      image: ogImage,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      publisher: { '@type': 'Organization', name: siteName, url: 'https://kaddo.org/' },
      ...(tags.length ? { keywords: tags.join(', ') } : {}),
      inLanguage: locale,
    }
  : null
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {type === 'article' && (
      <>
        <meta property="article:author" content={author} />
        {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
        {(updatedAt ?? publishedAt) && <meta property="article:modified_time" content={(updatedAt ?? publishedAt)!.toISOString()} />}
        {tags.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}

    <link rel="alternate" type="application/rss+xml" title="Kaddo Blog" href={locale === 'es' ? '/es/blog/rss.xml' : '/blog/rss.xml'} />
    {alternate && <link rel="alternate" hreflang={alternate.locale} href={new URL(alternate.path, site).href} />}
    {alternate && <link rel="alternate" hreflang={locale} href={canonical} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Website analytics (WI-028) — same component Starlight pages use, so the blog is covered too. */}
    <Analytics />
    <script is:inline>
      const savedTheme = localStorage.getItem('kaddo-blog-theme')
      if (savedTheme === 'dark' || savedTheme === 'light') document.documentElement.dataset.theme = savedTheme
    </script>
  </head>
  <body>
    <header class="blog-header">
      <a class="brand" href={homeHref}>Kaddo</a>
      <nav class="blog-nav">
        <a href={homeHref}>{docsLabel}</a>
        <a href={locale === 'es' ? '/es/blog/' : '/blog/'} aria-current="page">Blog</a>
        <a href="https://github.com/Kaddo-kdd/kaddo" rel="noopener">GitHub</a>
        <label class="blog-theme" aria-label={locale === 'es' ? 'Tema visual' : 'Color theme'}>
          <span aria-hidden="true">Theme</span>
          <select id="kaddo-blog-theme">
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
        <span class="lang-switch" aria-label={locale === 'es' ? 'Cambiar idioma' : 'Switch language'}>
          {locale === 'en' ? <span class="current" aria-current="true">EN</span> : <a href={switchHref}>EN</a>}
          <span class="sep">/</span>
          {locale === 'es' ? <span class="current" aria-current="true">ES</span> : <a href={switchHref}>ES</a>}
        </span>
      </nav>
    </header>

    <main class="blog-main">
      <slot />
    </main>

    <footer class="blog-footer">
      <span>© {new Date().getFullYear()} Kaddo</span>
      <span>·</span>
      <a href={homeHref}>{docsLabel}</a>
      <span>·</span>
      <a href="https://github.com/Kaddo-kdd/kaddo" rel="noopener">GitHub</a>
    </footer>

    <style is:global>
      :root { color-scheme: light; }
      html { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
      body {
        margin: 0;
        background: var(--sl-color-bg);
        color: var(--sl-color-white);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      a { color: var(--sl-color-accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1, h2, h3 { font-family: 'Poppins', 'Inter', sans-serif; letter-spacing: -0.01em; line-height: 1.2; }

      .blog-header {
        display: flex; align-items: center; justify-content: space-between;
        max-width: 1100px; margin: 0 auto; width: 100%;
        padding: 18px 24px; box-sizing: border-box;
        border-bottom: 1px solid var(--kaddo-border);
      }
      .brand { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 20px; color: var(--sl-color-white); letter-spacing: -0.04em; }
      .blog-nav { display: flex; align-items: center; gap: 22px; font-size: 15px; }
      .blog-nav > a { color: var(--kaddo-tech-gray); }
      .blog-nav > a[aria-current='page'] { color: var(--kaddo-amber); }
      .lang-switch { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; }
      .lang-switch a { color: var(--kaddo-tech-gray); }
      .lang-switch a:hover { color: var(--kaddo-amber); }
      .lang-switch .current { color: var(--kaddo-navy); }
      .lang-switch .sep { color: var(--kaddo-border); font-weight: 400; }

      .blog-main { flex: 1; max-width: 860px; width: 100%; margin: 0 auto; padding: 56px 24px 72px; box-sizing: border-box; }

      .blog-footer {
        display: flex; gap: 10px; align-items: center; justify-content: center;
        padding: 24px; font-size: 14px; color: var(--kaddo-tech-gray);
        border-top: 1px solid var(--kaddo-border);
      }
      .blog-footer a { color: var(--kaddo-tech-gray); }
      .blog-theme { display: inline-flex; align-items: center; gap: 5px; color: var(--kaddo-tech-gray); font-size: 12px; }
      .blog-theme select { appearance: none; border: 1px solid var(--kaddo-border); border-radius: 999px; background: var(--kaddo-surface); color: var(--sl-color-white); padding: 4px 23px 4px 9px; font: inherit; cursor: pointer; }

      @media (max-width: 600px) {
        .blog-nav { gap: 16px; font-size: 14px; }
        .blog-theme > span { display: none; }
        .blog-main { padding: 28px 18px 48px; }
      }
    </style>
  </body>
</html>

<script>
  const selector = document.querySelector<HTMLSelectElement>('#kaddo-blog-theme')
  const savedTheme = localStorage.getItem('kaddo-blog-theme')
  const initialTheme = savedTheme === 'dark' ? 'dark' : 'light'
  document.documentElement.dataset.theme = initialTheme
  if (selector) {
    selector.value = initialTheme
    selector.addEventListener('change', () => {
      const theme = selector.value === 'dark' ? 'dark' : 'light'
      document.documentElement.dataset.theme = theme
      localStorage.setItem('kaddo-blog-theme', theme)
    })
  }
</script>
