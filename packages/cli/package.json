{
  "name": "@kaddo/cli",
  "version": "3.87.0",
  "description": "Knowledge Driven Development toolkit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaddo-kdd/kaddo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://kaddo.trycatch.tv",
  "bugs": {
    "url": "https://github.com/Kaddo-kdd/kaddo/issues"
  },
  "keywords": [
    "kdd",
    "knowledge",
    "cli",
    "development"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core.js"
  },
  "bin": {
    "kaddo": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs');[['../admin/dist','dist/admin-dist'],['../admin-server/dist','dist/admin-server']].forEach(([s,d])=>{if(fs.existsSync(s)){fs.cpSync(s,d,{recursive:true})}})\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "execa": "^9.2.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "minimatch": "^10.2.5",
    "yaml": "^2.4.2",
    "zod": "^3.23.8",
    "open": "^10.1.0",
    "fastify": "^5.3.3",
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
